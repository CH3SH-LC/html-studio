{
  "name": "html-studio",
  "productName": "HTML Studio",
  "version": "0.3.0",
  "description": "轻松修改 AI HTML 演示稿的本地应用",
  "main": "src/main.cjs",
  "private": true,
  "license": "MIT",
  "author": "HTML Studio contributors",
  "repository": { "type": "git", "url": "git+https://github.com/CH3SH-LC/html-studio.git" },
  "homepage": "https://github.com/CH3SH-LC/html-studio#readme",
  "bugs": { "url": "https://github.com/CH3SH-LC/html-studio/issues" },
  "engines": { "node": ">=22" },
  "keywords": ["html", "presentation", "editor", "electron", "offline", "ai-slides"],
  "scripts": {
    "start": "node scripts/launch.cjs",
    "setup": "node scripts/runtime.cjs",
    "package": "node scripts/package.cjs",
    "release": "node scripts/release.cjs",
    "fetch:fixtures": "node scripts/fetch-fixtures.cjs",
    "pretest": "node scripts/fetch-fixtures.cjs --verify",
    "check:public": "node scripts/public-files.cjs --check",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:all": "node scripts/test-all.cjs",
    "test:real": "node tests/real-decks.cjs"
  },
  "dependencies": {
    "parse5": "7.3.0"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "reveal.js": "5.2.1"
  }
}
